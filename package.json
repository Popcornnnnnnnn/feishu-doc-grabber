{
  "name": "feishu-doc-grabber",
  "version": "1.3.2",
  "private": true,
  "description": "Local, integrity-aware Feishu and Lark document exporter",
  "bin": {
    "feishu-grab": "./cli.mjs",
    "feishu-grab-mcp": "./mcp/server.mjs",
    "feishu-chrome": "./tools/ai-chrome.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "FEISHU_BROWSER_SMOKE=1 node --test smoke.test.mjs",
    "grab": "node cli.mjs",
    "chrome": "node tools/ai-chrome.mjs",
    "validate:corpus": "node tools/validate-corpus.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "npm run build:extension && node tools/verify-extension.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "cli.mjs",
    "grab.mjs",
    "lib/",
    "mcp/",
    "tools/ai-chrome.mjs",
    "README.md",
    "INTEGRITY.md",
    "docs/feishu-grab.1",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "dependencies": {
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.10.0"
  }
}
