{
  "manifest_version": 3,
  "name": "Feishu Grabber",
  "version": "0.2.7",
  "description": "Export the current Feishu or Lark document as Markdown with local assets and an integrity report.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "downloads", "offscreen", "storage", "debugger"],
  "host_permissions": ["https://*.feishu.cn/*", "https://*.larkoffice.com/*", "https://*.larksuite.com/*"],
  "action": { "default_title": "Export this document", "default_popup": "extension/task.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "extension/background.mjs", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'" }
}
